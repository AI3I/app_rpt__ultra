[Unit]
Description=app_rpt__ultra Kerchunk Detection Daemon
Documentation=https://github.com/AI3I/app_rpt__ultra
After=asterisk.service
Requires=asterisk.service
# Give up after 5 failures in 10 minutes instead of restarting forever
# (a crash loop restarted every 10s and flooded app_rpt.log)
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=asterisk
Group=asterisk
ExecStart=/opt/app_rpt/bin/kerchunkd.sh
Restart=on-failure
RestartSec=10
StandardOutput=append:/opt/app_rpt/log/app_rpt.log
StandardError=append:/opt/app_rpt/log/app_rpt.log

# Security settings
NoNewPrivileges=true
PrivateTmp=true

# Resource limits
LimitNOFILE=1024
LimitNPROC=512

[Install]
WantedBy=multi-user.target
